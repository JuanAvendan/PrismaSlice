{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Embeddings": {
    "Provider": "Ollama",
    "Dimensions": 768,
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "nomic-embed-text"
    },
    "OpenAI": {
      "Model": "text-embedding-3-small"
    }
  }
}
